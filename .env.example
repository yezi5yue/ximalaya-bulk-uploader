# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values.
# All keys are OPTIONAL: CLI arguments override them, and a bare
# `python uploader.py --folder ... --album ...` also works.
# ─────────────────────────────────────────────────────────────

# Required: the folder that contains your audio files and their
# same-named .txt description files.
XIMALAYA_FOLDER=/path/to/your/audio/folder

# Required: the exact album (作品目录) name in your Ximalaya account.
XIMALAYA_ALBUM=My Album Name

# Optional: directory used to persist the logged-in Chrome profile
# (so you only scan the QR code once). Defaults to ./xmly_profile
# XIMALAYA_PROFILE=/absolute/path/to/xmly_profile

# Optional: visibility of published sounds.
#   private = 私密 (default), public = 公开, fans = 仅粉丝可见
XIMALAYA_VISIBILITY=private

# Optional: if set, this prefix is stripped from each audio file name
# to build the published title. e.g. "Lesson-" turns
# "Lesson-01.mp3" into title "01". Leave empty to keep full names.
XIMALAYA_TITLE_PREFIX=

# Optional: publish order. 'name' (default) = ascending natural sort of file
# names; 'preview-first' = group by chapter and publish 预习 (preview) files
# before 复习 (review) files within each chapter; 'chapter-first' = sort by
# chapter number ascending and put files without a chapter marker at the end.
# XIMALAYA_ORDER=name

# Optional: run the browser headless (true) or show the window (false).
# `--headless` is also accepted on the CLI (it is the default).
XIMALAYA_HEADLESS=true

# Optional: seconds to wait between two uploads (anti rate-limit).
XIMALAYA_INTERVAL=8

# Optional: extra RANDOM seconds added on top of XIMALAYA_INTERVAL between
# uploads. The real wait becomes interval + random(0..jitter), which avoids a
# fixed rhythm that platforms flag as bot traffic. Default 7.
XIMALAYA_INTERVAL_JITTER=7

# Optional: timeout (seconds) waiting for a single file to finish uploading.
XIMALAYA_UPLOAD_TIMEOUT=300

# Optional: seconds to wait after clicking "publish" before the next item.
XIMALAYA_AFTER_PUBLISH=5

# Optional: numeric album id (from the Creator Center URL). Required for the
# automatic post-publish verification (completeness + order). If omitted, the
# verification step is skipped.
# XIMALAYA_ALBUM_ID=128358894

# Optional: enable/disable the automatic post-publish verification.
# XIMALAYA_VERIFY=true

# Optional: order check strictness: strict (default, online order must match
# chapter order) | monotonic (asc or desc accepted) | off (skip order check).
# XIMALAYA_VERIFY_ORDER=strict

# Optional: exit with a non-zero code when verification finds problems.
# XIMALAYA_VERIFY_FAIL_EXIT=true
